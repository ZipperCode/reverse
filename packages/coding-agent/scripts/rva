#!/bin/sh
# Compatibility launcher for the rva CLI alias, delegating to reverse CLI.
set -e

self=$0
while [ -L "$self" ]; do
	link=$(readlink "$self")
	case $link in
	/*) self=$link ;;
	*) self=$(dirname "$self")/$link ;;
	esac
done
scripts_dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd -P)
cli=$scripts_dir/../src/cli.ts
preload=$scripts_dir/reverse.ts
timing_preload=$scripts_dir/../../utils/src/module-timer.ts

launch_dir=${REVERSE_DEV_LAUNCH_DIR:-${RVA_DEV_LAUNCH_DIR:-${HOME}/.reverse/.dev-cwd}}
mkdir -p "$launch_dir"

REVERSE_LAUNCH_CWD=$PWD
RVA_LAUNCH_CWD=$PWD
export REVERSE_LAUNCH_CWD
export RVA_LAUNCH_CWD
cd "$launch_dir"

run_bun() {
	if [ "${HERDR_ENV:-}" = 1 ] && [ "$(uname -s)" = Darwin ]; then
		exec -a reverse bun "$@"
	fi
	exec bun "$@"
}

if [ -n "${REVERSE_TIMING:-${RVA_TIMING:-}}" ]; then
	run_bun --preload "$preload" --preload "$timing_preload" "$cli" "$@"
fi
run_bun --preload "$preload" "$cli" "$@"
