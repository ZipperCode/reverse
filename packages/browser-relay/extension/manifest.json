{
	"manifest_version": 3,
	"name": "RVA Browser Relay",
	"version": "0.1.0",
	"description": "Lets the rva coding agent drive your existing tabs through a local CDP relay.",
	"author": "Stencil Labs, Inc.",
	"homepage_url": "https://omp.sh",
	"permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
	"background": {
		"service_worker": "background.js"
	},
	"options_page": "options.html",
	"action": {
		"default_title": "RVA Browser Relay (click for settings)"
	}
}
